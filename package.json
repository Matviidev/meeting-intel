{
  "name": "meeting-intel",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "migrate": "pnpm --filter @meeting-intel/api migrate",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @meeting-intel/api eval",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2"
  }
}
